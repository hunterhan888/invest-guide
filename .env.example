# ============================================================
# 安全（必填）
# ============================================================
# JWT_SECRET 是唯一启动必填项；生产环境必须替换为随机长字符串
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min!

# ============================================================
# 服务器
# ============================================================
PORT=8080
# 数据库连接串（postgres:// 或 sqlite://）；生产 compose 会覆盖为容器内地址
DATABASE_URL=postgres://invest:invest@localhost:5432/investguide?sslmode=disable

# ============================================================
# 生产部署（docker-compose.prod.yml 使用）
# ============================================================
# 访问域名。无域名（未备案）留空，用 http://<服务器IP>；有域名则填 https 域名，Caddy 自动签发证书
DOMAIN=
# PostgreSQL 密码（生产环境务必修改）
POSTGRES_PASSWORD=invest

# ============================================================
# LLM（OpenAI-compatible）
# ============================================================
# API Key 可选：缺失时允许启动，但 LLM 调用返回 502
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60s
LLM_STREAM_TIMEOUT=120s

# ============================================================
# Embedding（OpenAI-compatible）
# ============================================================
# BASE_URL / API_KEY 留空则默认复用 LLM 对应项
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# ============================================================
# 其他
# ============================================================
# 允许跨域的来源；生产经 Caddy 同源访问，可保持默认或填你的域名（如 https://example.com）
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
# 日志文件路径（留空则输出到 stdout）。相对路径相对于 backend 工作目录
LOG_FILE=logs/backend.log
RATE_LIMIT_API=60
RATE_LIMIT_SENSITIVE=20
